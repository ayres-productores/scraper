# ============================================================
# CONFIGURACIÓN DEL PORTAL DE SEGUROS
# ============================================================
# Copiar este archivo como .env y configurar los valores

# ============================================================
# SEGURIDAD (OBLIGATORIOS EN PRODUCCIÓN)
# ============================================================

# Clave secreta para sesiones Flask (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=tu_clave_secreta_aqui_64_caracteres_hex

# Clave de encriptación para credenciales Gmail (exactamente 32 caracteres)
# Generar con: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=tu_clave_encriptacion_32chars

# Token de verificación para webhook de WhatsApp
WHATSAPP_VERIFY_TOKEN=tu_token_verificacion_webhook

# ============================================================
# MODO DE EJECUCIÓN
# ============================================================

# development = modo desarrollo (permite claves por defecto)
# production = modo producción (requiere todas las claves)
FLASK_ENV=development

# Activar modo debug (solo desarrollo)
FLASK_DEBUG=1

# ============================================================
# WHATSAPP BUSINESS API
# ============================================================

# Credenciales de Meta Business
WHATSAPP_API_KEY=EAAxxxxx_TU_TOKEN_DE_META_xxxxx
WHATSAPP_PHONE_ID=123456789012345

# App Secret para validar firma HMAC de webhooks (CRÍTICO PARA SEGURIDAD)
# Sin esto, cualquier atacante podría enviar webhooks falsos y manipular datos.
# Se obtiene de: Meta Developer Dashboard > App Settings > Basic > App Secret
# IMPORTANTE: Nunca compartir este secreto. Es diferente al API Key.
WHATSAPP_APP_SECRET=tu_app_secret_de_meta_aqui

# El modo se configura automáticamente como 'api' cuando estas credenciales existen
# Forzar modo: api, manual
# WHATSAPP_MODO=api

# ============================================================
# WHATSAPP WEB SERVICE (Opcional)
# ============================================================

# URL del servicio de WhatsApp Web
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SERVICE_TIMEOUT=30

# ============================================================
# BASE DE DATOS (Opcional)
# ============================================================

# Por defecto usa SQLite en portal_seguros.db
# DATABASE_URL=sqlite:///portal_seguros.db
# DATABASE_URL=postgresql://user:pass@localhost/portal_seguros
