{
  "version": "1.0",
  "descripcion": "Configuración de estrategias de extracción por compañía de seguros",
  "default_compania": "generica",

  "companias": {
    "mercantil_andina": {
      "nombre": "Mercantil Andina Seguros",
      "activa": true,
      "dominios": ["lamercantil.com.ar", "mercantilandina.com.ar"],
      "tipo_extraccion": "enlace_html",

      "filtros_imap": {
        "filtrar_por_from": true,
        "subject_keywords": ["póliza", "emisión", "documento"],
        "subject_excluir": ["baja", "anulación", "cancelación"]
      },

      "config_enlaces": {
        "patron_url": "api_papeleria.*?/descarga\\?token=",
        "texto_boton": ["descarga", "download", "descargar", "ver documento"],
        "excluir_urls": ["/baja", "distribucion_digital", "unsubscribe", "mailto:"],
        "max_enlaces_por_correo": 3,
        "timeout_descarga_segundos": 30,
        "headers_adicionales": {
          "Accept": "application/pdf,*/*"
        }
      },

      "limites": {
        "dias_max_antiguedad": 89,
        "tamano_max_pdf_mb": 25
      },

      "validacion_pdf": {
        "palabras_requeridas": [],
        "palabras_cualquiera": ["MERCANTIL ANDINA", "LA MERCANTIL", "PÓLIZA", "ASEGURADO"],
        "palabras_excluir": ["CERTIFICADO DE COBERTURA PROVISORIO"],
        "min_caracteres": 500
      },

      "extraccion_datos": {
        "usar_patrones_especificos": true
      },

      "renombrado": {
        "formato": "{asegurado}_{patente}_{fecha}.pdf",
        "max_longitud_nombre": 100
      }
    },

    "liderar": {
      "nombre": "Liderar Cía. Gral. de Seguros",
      "activa": true,
      "dominios": ["liderar.com.ar", "liderarseguros.com.ar"],
      "tipo_extraccion": "adjunto",

      "filtros_imap": {
        "filtrar_por_from": true,
        "subject_keywords": ["póliza", "certificado", "emisión"]
      },

      "config_adjuntos": {
        "extensiones_permitidas": [".pdf"],
        "excluir_nombres": ["factura", "recibo", "aviso"]
      },

      "limites": {
        "dias_max_antiguedad": 365,
        "max_adjuntos_por_correo": 5,
        "tamano_max_pdf_mb": 25
      },

      "validacion_pdf": {
        "palabras_cualquiera": ["LIDERAR", "PÓLIZA", "ASEGURADO"],
        "palabras_excluir": ["ANULADA", "SIN EFECTO"]
      },

      "extraccion_datos": {
        "usar_patrones_especificos": true
      },

      "renombrado": {
        "formato": "{asegurado}_{bien}_{fecha}.pdf"
      }
    },

